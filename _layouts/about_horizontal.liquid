---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article class="scholar-home">
    <div class="row g-4 align-items-start">
      <div class="col-lg-8">
        <div class="clearfix">{{ content }}</div>

        {% if page.social %}
          <div class="social mt-4">
            <div class="contact-icons">{% social_links %}</div>
            <div class="contact-note">{{ site.contact_note }}</div>
          </div>
        {% endif %}
      </div>

      <div class="col-lg-4">
        <aside class="scholar-sidebar">
          {% if page.profile and page.profile.image %}
            <div class="profile portrait-card">
              {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
              {% if page.profile.image_circular %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
              {% else %}
                {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
              {% endif %}
              {% capture sizes %}(min-width: {{ site.max_width }}) 320px, 85vw"{% endcapture %}
              {%
                include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
                cache_bust=true
              %}
            </div>
          {% endif %}

          {% if page.snapshot %}
            <div class="snapshot-panel">
              {% for item in page.snapshot %}
                <div class="snapshot-item">
                  <span>{{ item.label }}</span>
                  <strong>{{ item.value }}</strong>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if page.sidebar_note %}
            <div class="sidebar-note">{{ page.sidebar_note }}</div>
          {% endif %}

          <div class="sidebar-actions">
            <a
              class="btn btn-sm btn-primary"
              href="{{ '/assets/pdf/CV_Muchen__Academy_.pdf' | relative_url }}"
              target="_blank"
              rel="noopener noreferrer"
              >Download CV</a
            >
            <a class="btn btn-sm btn-outline-primary" href="{{ '/publications/' | relative_url }}">Publications</a>
          </div>
        </aside>
      </div>
    </div>

    {% if page.selected_papers %}
      <section class="home-selected-papers">
        <h2>
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    {% if page.announcements and page.announcements.enabled %}
      <section class="home-news">
        <h2>
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
